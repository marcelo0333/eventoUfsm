# Banco de dados (usado pelo docker-compose da raiz)
POSTGRES_DB=eventsDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

DB_HOST=db
DB_PORT=5432

# JWT — em produção gere uma chave Base64 de 256+ bits. O compose tem um
# default de desenvolvimento, mas defina aqui para não usar o valor de dev.
JWT_SECRET=troque-por-uma-chave-base64-de-256-bits
