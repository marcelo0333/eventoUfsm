# Configurações do Servidor
SERVER_PORT=9090
SERVER_ADDRESS=0.0.0.0
CONTEXT_PATH=/api

# Banco de Dados
DB_URL=jdbc:postgresql://localhost:5432/eventsDB
DB_USER=postgres
DB_PASSWORD=changeme

# JWT — gere uma chave Base64 de 256+ bits e mantenha fora do versionamento
JWT_SECRET=changeme-generate-a-256-bit-base64-secret

# Upload de Arquivos e Diretórios
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
IMAGE_DIR=./uploads/assets

# Configurações do Scrapper
SCRAPPER_SCRIPT_PATH=../scrapper_events_ufsm/src/scrape/getEvents.ts
SCRAPPER_WORK_DIR=../scrapper_events_ufsm
